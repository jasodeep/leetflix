{
  "name": "leetflix",
  "version": "0.1.0",
  "private": true,
  "description": "LeetCode problem catalogue with explained Python and Go solutions and interactive algorithm animations for coding interview prep.",
  "license": "MIT",
  "author": "Jasodeep Chatterjee",
  "homepage": "https://jasodeep.github.io/leetflix/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasodeep/leetflix.git"
  },
  "bugs": {
    "url": "https://github.com/jasodeep/leetflix/issues"
  },
  "keywords": [
    "leetcode",
    "leetcode-solutions",
    "algorithms",
    "algorithm-visualization",
    "interview-prep",
    "coding-interview",
    "data-structures",
    "dsa",
    "python",
    "golang",
    "nextjs",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check",
    "sync:leetcode": "node scripts/sync-leetcode.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
